# Google OAuth Configuration
# Tạo tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Admin Gmail (email quản trị viên - phân cách bằng dấu phẩy)
ADMIN_EMAILS=admin@gmail.com

# Email thông báo (gửi mail khi có đăng ký mới)
NOTIFY_EMAIL=admin@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_16_chars

# Session secret
SESSION_SECRET=thay-bang-chuoi-bi-mat-cua-ban

# Frontend URL
FRONTEND_URL=http://localhost:8443

# Backend Port
BACKEND_PORT=3001

# Chatbot (Claude API) - tạo khóa tại https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key
# Mô hình dùng cho chatbot (mặc định: claude-haiku-4-5-20251001 - nhanh, rẻ)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
