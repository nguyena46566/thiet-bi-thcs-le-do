# Sao chép file này thành backend/.env rồi điền giá trị thật.
# KHÔNG BAO GIỜ commit file .env lên GitHub.

# Cơ sở dữ liệu PostgreSQL (Supabase: Project Settings > Database > Connection string > "Session pooler")
# Bỏ trống khi chạy thử trên máy -> dữ liệu lưu vào backend/data/*.json
DATABASE_URL=

# Google OAuth - tạo tại https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Email quản trị viên (phân cách bằng dấu phẩy)
ADMIN_EMAILS=admin@gmail.com

# Gửi email khi có yêu cầu mượn mới (Gmail: dùng "Mật khẩu ứng dụng" 16 ký tự)
NOTIFY_EMAIL=admin@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_16_chars

# Chuỗi ngẫu nhiên dài, tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Chỉ cần khi chạy dev (frontend và backend khác cổng)
FRONTEND_URL=http://localhost:8443
BACKEND_PORT=3001

# Chatbot AI (Google Gemini) - tạo tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Model dự phòng khi model chính quá tải (mặc định: gemini-2.5-flash-lite)
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
